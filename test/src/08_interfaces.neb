import { section, expectEq, expect } from "_runner"

interface Greetable
    function greet(): string
end

interface Named
    name: string
end

interface Printable extends Greetable
    function shout(): string
end

class Robot implements Printable, Named
    name: string

    constructor(name: string)
        self.name = name
    end

    function greet(): string
        return "beep, I am " .. self.name
    end

    function shout(): string
        return string.upper(self:greet())
    end
end

local function callGreet(g: Greetable): string
    return g:greet()
end

declare interface Damageable
    function getHealth(): number
end

declare interface Paintable extends Damageable
    function setColor(color: string): nil
end

declare class Entity
    function getId(): number
end

declare class Character extends Entity implements Paintable
    function respawn(): nil
end

interface Configurable
    function label(prefix: string = "cfg"): string
    function describe(suffix: string = "!"): string
        return "default" .. suffix
    end
end

class Widget implements Configurable
    function label(prefix: string = "cfg"): string
        return prefix .. ":widget"
    end
end

local function inspectExternal(c: Character): number
    c:setColor("red")
    c:respawn()
    return c:getId() + c:getHealth()
end

export function run(): nil
    section("interfaces")

    local r = new Robot("R2")

    expectEq("interface field via class", r.name, "R2")
    expectEq("interface method", r:greet(), "beep, I am R2")
    expectEq("inherited interface method", r:shout(), "BEEP, I AM R2")

    -- Pass class instance through an interface-typed parameter
    expectEq("polymorphic call", callGreet(r), "beep, I am R2")

    expectEq("declared class inherits interface signatures", type(inspectExternal), "function")

    local w = new Widget()
    expectEq("interface default param omitted", w:label(), "cfg:widget")
    expectEq("interface default param supplied", w:label("ui"), "ui:widget")
    expectEq("inherited default method uses its default", w:describe(), "default!")
    expectEq("inherited default method with argument", w:describe("?"), "default?")

    local c: Configurable = w
    expectEq("default param through interface receiver", c:label(), "cfg:widget")
end
