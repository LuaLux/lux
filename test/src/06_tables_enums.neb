import { section, expectEq, expect } from "_runner"

enum Color
    Red
    Green
    Blue
end

enum Status
    Active = "ACTIVE"
    Inactive = "INACTIVE"
end

export function run(): nil
    section("tables")

    -- Array-style table
    local arr: number[] = { 10, 20, 30 }
    expectEq("array len", #arr, 3)
    expectEq("array index 1", arr[1], 10)
    expectEq("array index 3", arr[3], 30)

    arr[2] = 99
    expectEq("array assign", arr[2], 99)

    table.insert(arr, 40)
    expectEq("table.insert appends", arr[4], 40)
    expectEq("array len after insert", #arr, 4)

    -- Map / struct-style table
    local point = { x = 3, y = 4 }
    expectEq("struct field x", point.x, 3)
    expectEq("struct field y", point.y, 4)
    point.x = 30
    expectEq("struct field assign", point.x, 30)

    -- Mixed table
    local mixed = { 1, 2, 3, name = "ok" }
    expectEq("mixed array part", mixed[2], 2)
    expectEq("mixed map part", mixed.name, "ok")

    -- Bracket key access
    local dict = { ["one-two"] = 12 }
    expectEq("bracket key", dict["one-two"], 12)

    -- Named-function fields: shorthand for `name = function ... end`
    local ops = {
        function add(a: number, b: number): number
            return a + b
        end,
        function negate(v: number): number
            return -v
        end,
        scale = function(v: number, by: number): number
            return v * by
        end,
    }
    expectEq("function field add", ops.add(2, 3), 5)
    expectEq("function field negate", ops.negate(7), -7)
    expectEq("function field beside longhand", ops.scale(4, 5), 20)

    -- The shorthand only claims a `function` followed by a Name; anonymous
    -- functions still take an integer key.
    local mixedFns = {
        function named() return "named" end,
        function() return "anon" end,
        label = "tail",
    }
    expectEq("named field keeps string key", mixedFns.named(), "named")
    expectEq("anonymous field keeps integer key", mixedFns[1](), "anon")
    expectEq("plain field beside both", mixedFns.label, "tail")

    -- An explicit `self` parameter makes a table field callable with `:`
    local counter = {
        total = 0,
        function bump(self: any, by: number): number
            self.total = self.total + by
            return self.total
        end,
    }
    expectEq("self field via colon", counter:bump(3), 3)
    expectEq("self field accumulates", counter:bump(4), 7)

    section("enums")

    -- Auto-incremented enum
    expectEq("enum auto Red", Color.Red, 0)
    expectEq("enum auto Green", Color.Green, 1)
    expectEq("enum auto Blue", Color.Blue, 2)

    -- Explicit string enum
    expectEq("enum string Active", Status.Active, "ACTIVE")
    expectEq("enum string Inactive", Status.Inactive, "INACTIVE")

    -- Enum value compare
    local mut col = Color.Green
    if col == Color.Green then
        expect("enum equality narrowing", true)
    else
        expect("enum equality narrowing", false)
    end
    -- The `is` operator against enum types
    local shade: any = Color.Green
    expect("is against an enum member", shade is Color)
    expect("is rejects a non-member", not (99 is Color))

    -- Both spellings of unpack, normalised to whichever one the target provides
    local packed: any = {4, 5, 6}
    local x1, y1, z1 = table.unpack(packed)
    expectEq("table.unpack first", x1, 4)
    expectEq("table.unpack last", z1, 6)
    local x2, y2, z2 = unpack(packed)
    expectEq("bare unpack first", x2, 4)
    expectEq("bare unpack last", z2, 6)

end
