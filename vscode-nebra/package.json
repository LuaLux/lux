{
  "name": "nebra",
  "displayName": "Nebra - A typed superset of Lua",
  "description": "Language support for Nebra, the typed superset of Lua",
  "version": "0.1.0",
  "publisher": "DasDarki",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://nebra-lang.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/nebra-lang/nebra.git"
  },
  "bugs": {
    "url": "https://github.com/nebra-lang/nebra/issues"
  },
  "keywords": [
    "nebra",
    "lua",
    "luajit",
    "transpiler",
    "type-checker"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:nebra"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nebra",
        "aliases": [
          "Nebra",
          "nebra"
        ],
        "extensions": [
          ".neb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      },
      {
        "id": "nebra",
        "aliases": [
          "Nebra Declaration"
        ],
        "extensions": [
          ".d.neb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "nebra",
        "scopeName": "source.nebra",
        "path": "./syntaxes/nebra.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "nebra.compileFile",
        "title": "Nebra: Compile this file",
        "category": "Nebra"
      }
    ],
    "configuration": {
      "title": "Nebra",
      "properties": {
        "nebra.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Nebra compiler executable. If empty, 'nebra' must be on PATH."
        },
        "nebra.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the Nebra language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  },
  "galleryBanner": {
    "color": "#040a14",
    "theme": "dark"
  }
}
